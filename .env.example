# Copie para .env e preencha. Nenhuma dessas variáveis tem valor padrão
# funcional: sem elas, os recursos correspondentes simplesmente não
# carregam (ver src/lib/analytics.ts e src/lib/site.ts).

# Domínio público do site. Usado em canonical, og:url, sitemap.xml e
# news-sitemap.xml. Sem isso cai no fallback https://sabia.blog.
VITE_SITE_URL=https://sabia.blog

# Google Tag e Google Analytics 4 — ambos aparecem na tela de instruções de
# tag da propriedade em analytics.google.com > Admin > Fluxos de dados > Web.
# O site carrega e configura pelo Google Tag (prefixo GT-), não pelo
# Measurement ID (prefixo G-) diretamente — são IDs "interchangeable"
# segundo a doc oficial do Google, e usar o GT- permite ligar produtos
# futuros (Google Ads etc.) só pela interface, sem novo deploy.
# Já existem fallbacks de produção em src/lib/analytics.ts (GT-WP45DRCV e
# G-MLZG3D3YNB); só preencha aqui se este deploy precisar apontar para outra
# propriedade (ex.: staging, para não misturar dados de teste com o tráfego real).
VITE_GOOGLE_TAG_ID=
VITE_GA_MEASUREMENT_ID=

# Search Console — em search.google.com/search-console, adicione a
# propriedade de domínio ou de prefixo de URL, escolha o método de
# verificação "Tag HTML" e copie apenas o valor do atributo content=
# da meta tag (não a tag inteira).
VITE_GSC_VERIFICATION=

# Supabase (já em uso; documentado aqui para o .env ficar completo)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
